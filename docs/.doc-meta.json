        ],
        "reason": "内核驱动代码变更影响架构、组件和安全模型文档"
      },
      {
        "code_pattern": "Sandboxie/core/dll/**",
        "affects_docs": [
          "docs/architecture/overview.md",
          "docs/architecture/components.md"
        ],
        "reason": "注入 DLL 代码变更影响架构和组件文档"
      },
